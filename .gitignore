# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects (generated by Continuous Native Generation - `npx expo prebuild`)
/PetPalsConnectApp/ios/
/PetPalsConnectApp/android/

# Native credentials - NEVER commit these
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem
google-services.json
GoogleService-Info.plist
**/serviceAccountKey.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# Environment files - NEVER commit these. Use .env.example as the template.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# EAS
.eas/

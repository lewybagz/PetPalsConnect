# Copy to .env and fill in real values. NEVER commit .env.
#
# In Expo, only variables prefixed with EXPO_PUBLIC_ are readable from app code.
# They are EMBEDDED IN THE APP BUNDLE and are therefore PUBLIC.
# Never put a secret (private key, Stripe secret key, DB password) in here.

# Base URL of the backend API.
# Physical device on the same LAN: use your machine's LAN IP, not localhost.
# Android emulator: http://10.0.2.2:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Firebase Web config (safe to expose - these are public client identifiers).
# Firebase Console > Project Settings > General > Your apps > Web app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Sign-In web client ID (public).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- Maps ---
# Read by the react-native-maps config plugin in app.json at PREBUILD time, not
# at runtime - which is why they are not EXPO_PUBLIC_ and why changing one means
# rebuilding, not just restarting Metro.
#
# Android needs a key with "Maps SDK for Android" enabled; without it the map
# renders as a blank grey grid with a Google watermark and no error. iOS uses
# Apple Maps and needs no key at all, so iosApiKey can stay empty unless you
# switch the provider.
#
# Google Cloud Console > APIs & Services > Credentials > Create credentials >
# API key. Restrict the Android key to your package name
# (com.petpalsconnect.app) and its SHA-1 before shipping.
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=

# Stripe publishable key (public by design - it identifies the account, it does
# not authorise charges). Leave it empty and the app simply hides the plan
# picker; everything else still works.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
#
# Apple Pay is off. Turning it on means registering a merchant ID with Apple and
# putting it in the @stripe/stripe-react-native plugin props in app.json
# ({ "merchantIdentifier": "merchant.com.petpalsconnect.app" }); it adds an
# entitlement, so the build fails if the ID is not registered.

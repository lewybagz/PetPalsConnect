# Copy to .env and fill in real values. NEVER commit .env.

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS. Leave unset in dev.
CORS_ORIGINS=

# --- MongoDB ---
# Atlas free tier (M0) is sufficient to start: https://www.mongodb.com/cloud/atlas/register
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/petpals?retryWrites=true&w=majority

# --- Firebase Admin (server-side ID token verification + push notifications) ---
# From Firebase Console > Project Settings > Service Accounts > Generate new private key.
# Paste the JSON's fields here. Keep the \n escapes in the private key intact.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Google Maps (server-side place lookups) ---
# Needs "Places API" enabled. Used only by the importer that fills the map with
# nearby parks and pet shops: without it `POST /api/locations/import` reports
# 503 and the map shows whatever rows already exist, which on a fresh
# deployment is none. Restrict by API + IP in Google Cloud Console before
# shipping - this one IS a secret and never reaches the app.
GOOGLE_MAPS_API_KEY=your-server-maps-key

# --- Stripe (subscriptions) ---
# Without STRIPE_SECRET_KEY the payment routes report 503 and the app hides the
# plan picker; the rest of the API is unaffected.
STRIPE_SECRET_KEY=sk_test_xxx
# `stripe listen --forward-to localhost:4000/api/stripe-webhooks` prints this.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Recurring price ids from Stripe Dashboard > Product catalogue. Prices live in
# Stripe, never in the app - a plan with no id here is shown as unavailable.
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_YEARLY=price_xxx

# --- Moderation ---
# Comma-separated emails allowed to read the report queue and action reports.
# There is no admin role in the database on purpose: an allowlist the deployer
# controls needs no schema, no UI to grant it, and cannot be escalated into from
# inside the app. Leave unset and the moderation routes 404 for everybody -
# reports still auto-hide an account once three separate people report it.
MODERATOR_EMAILS=

# --- Email (support / notifications) ---
GMAIL_EMAIL=you@example.com
GMAIL_APP_PASSWORD=your-16-char-app-password

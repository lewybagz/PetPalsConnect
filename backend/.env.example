# Copy to .env and fill in real values. NEVER commit .env.

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS. Leave unset in dev, where
# an empty value reflects any origin.
#
# This is the one variable whose failure shape is backwards: unset, the
# marketing site's waitlist form works fine locally, and then stops working
# the moment this is set in production - because the first origin anybody
# adds is rarely the website's. The app itself is native and sends no Origin,
# so the site is the only thing this affects. Set BOTH hostnames: a browser
# treats them as different origins and only one of them is what the visitor
# actually typed.
CORS_ORIGINS=https://petpalsconnectapp.com,https://www.petpalsconnectapp.com

# --- MongoDB ---
# Atlas free tier (M0) is sufficient to start: https://www.mongodb.com/cloud/atlas/register
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/petpals?retryWrites=true&w=majority

# --- Firebase Admin (server-side ID token verification + push notifications) ---
# From Firebase Console > Project Settings > Service Accounts > Generate new private key.
# Paste the JSON's fields here. Keep the \n escapes in the private key intact.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Where the app uploads photos; account deletion empties the account's folders
# in it. Defaults to <project-id>.firebasestorage.app - override for an older
# project on <project-id>.appspot.com.
FIREBASE_STORAGE_BUCKET=

# --- Google Maps (server-side place lookups) ---
# Needs "Places API" enabled. Used only by the importer that fills the map with
# nearby parks and pet shops: without it `POST /api/locations/import` reports
# 503 and the map shows whatever rows already exist, which on a fresh
# deployment is none. Restrict by API + IP in Google Cloud Console before
# shipping - this one IS a secret and never reaches the app.
GOOGLE_MAPS_API_KEY=your-server-maps-key

# --- RevenueCat (subscriptions) ---
# Purchases happen in the app through the store; RevenueCat posts each
# lifecycle event to /api/revenuecat-webhooks. In the RevenueCat dashboard
# (Project > Integrations > Webhooks) set the Authorization header to exactly
# this value. Empty means the webhook answers 503 and nobody becomes a
# subscriber; the rest of the API is unaffected.
REVENUECAT_WEBHOOK_SECRET=

# --- Stripe (the shop: goods that ship) ---
# Physical goods must NOT use in-app purchase (Apple 3.1.3(e), Play's
# physical-goods rule) - so merch and the tracking collar go through Stripe's
# hosted Checkout page, while the subscription stays on RevenueCat. Set both or
# neither; a key without a webhook secret would take payments the server never
# records, and boot refuses it. Each catalogue sku in services/store/products.js
# is the *lookup key* of a Price in the dashboard - the price lives there, not
# in the source. Enable Stripe Tax with a registered nexus (Arizona at minimum)
# before going live; it calculates, it does not register or file for you.
STRIPE_SECRET_KEY=
# Developers > Webhooks > endpoint /api/stripe-webhooks, events:
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, charge.refunded, charge.dispute.created
STRIPE_WEBHOOK_SECRET=
# Optional: shipping_rate ids from the dashboard, comma-separated. Empty means
# Checkout charges no postage.
STRIPE_SHIPPING_RATE_IDS=
# Optional: where Checkout sends the buyer back. Defaults to the app's deep
# link scheme; the app appends /order/{session} and /cancelled.
STORE_RETURN_URL=

# --- Tracking collar ---
# Which adapter in services/tracking/vendor/ collars report through. Unset
# means tracking is off: /api/tracking/* answers 503 and the app shows no
# tracking screens. "simulator" invents a slow loop per claimed collar so the
# feature can be developed with no hardware; "generic" accepts positions POSTed
# to /api/tracking/ingest with the per-device secret handed out at claim time.
# A real vendor is a third module and one line in vendor/index.js.
TRACKING_VENDOR=

# --- Pet insurance (care hub) ---
# Set both or neither. With both, the care hub shows a "Compare pet insurance"
# card that opens the URL and says on screen that it opens the named partner
# and that PetPals may be paid - the hub's rule is that a paid link discloses
# itself next to the link. A URL without a partner name is refused at boot.
# Leave both empty until there is a partner; the hub then has no card.
INSURANCE_COMPARE_URL=
INSURANCE_PARTNER_NAME=

# --- Moderation ---
# Comma-separated emails allowed to read the report queue and action reports.
# There is no admin role in the database on purpose: an allowlist the deployer
# controls needs no schema, no UI to grant it, and cannot be escalated into from
# inside the app. Leave unset and the moderation routes 404 for everybody -
# reports still auto-hide an account once three separate people report it.
MODERATOR_EMAILS=

# --- Email (support / notifications) ---
GMAIL_EMAIL=you@example.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# --- Spot (the assistant) ---
# Spot runs on the Claude API from this server; the key never reaches the app.
# Empty means Spot is off: every /api/spot route answers 503 and the app hides
# its entry points - a missing key never stops the app from opening. Create the
# key in a Console workspace of its own and set a monthly spend limit there.
ANTHROPIC_API_KEY=
# Optional. The one-line cost lever: claude-opus-5 (default) or claude-sonnet-5.
SPOT_MODEL=
# Optional. A cheaper model for turns the software router judges light (no
# photo, no health or poison words, no write verb, no earlier heavy turn in the
# thread). Unset = every turn on SPOT_MODEL. Set only after
# `npm run eval:spot -- --model <name>` passes on that model.
SPOT_MODEL_LIGHT=
# Optional. An AI voice for "Read aloud": openai (default adapter, cheapest
# natural voice) or elevenlabs (the quality reference, about 3x the price).
# Unset = the app offers the phone's own voice only. Needs the matching key.
SPOT_VOICE_PROVIDER=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Optional. A voice name (OpenAI) or voice id (ElevenLabs); each adapter has a default.
SPOT_VOICE_ID=

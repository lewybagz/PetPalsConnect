{
  "name": "petpalsconnect-marketing",
  "version": "1.0.0",
  "private": true,
  "description": "The public site at petpalsconnectapp.com. Static. Imports nothing from the app or the backend.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run images && vite",
    "build": "npm run images && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "lint": "eslint .",
    "images": "npm run screens && npm run art",
    "screens": "node scripts/screens.mjs",
    "art": "node scripts/art.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.36.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.5"
  }
}
